    { "requestType": "SetStreamServiceSettings", "when": { "streaming": true }, "status": { "result": false, "code": 500, "comment": "You cannot change stream service settings while streaming." } },
    { "requestType": "SetRecordDirectory", "when": { "recording": true }, "status": { "result": false, "code": 500 } },
