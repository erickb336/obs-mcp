    { "requestType": "StopVirtualCam", "when": { "virtualCam": false }, "status": { "result": false, "code": 501 } },
    { "requestType": "StartReplayBuffer", "when": { "replayBuffer": true }, "status": { "result": false, "code": 500 } },
    { "requestType": "StopReplayBuffer", "when": { "replayBuffer": false }, "status": { "result": false, "code": 501 } },
