{
  "format": "obs-mcp-trace/1",
  "source": "simulated",
  "basis": "SIMULATED. Written by hand from the obs-websocket 5.7.6 protocol and the facts of the R210 probe of a real OBS 33.0.1 in Simple output mode (hybrid MOV): STARTING about 40 ms and STARTED 60 to 140 ms after a record start; STOPPING at 1 to 2 ms and STOPPED about 230 ms after a stop; the record output is simple_file_output, the only file output of that probe. PauseRecord on a paused output gives 502 and ResumeRecord on an output that is not paused gives 503, by reading the obs-websocket 5.7.6 source (RequestHandler_Record.cpp); both give 501 when nothing records. PAUSED at 21 ms with outputActive false, while the output stays active, and RESUMED at 6 ms, are from the R210 probe of a real OBS 33.0.1. The fake models GetOutputSettings of the record output (its path stays after the stop) and the record status. The effects of StopOutput, ToggleOutput and the stop hotkey on the record output are inferred from the source, not measured. Not captured from OBS. StartRecord and StopRecord are real now, in the real record trace.",
  "obs": { "obsVersion": "33.0.1", "obsWebSocketVersion": "5.7.6", "rpcVersion": 1 },
  "entries": [
    {
      "requestType": "ToggleRecord",
      "when": { "recording": false },
      "status": { "result": true, "code": 100 },
      "responseData": { "outputActive": true },
      "events": [
        { "delayMs": 40, "eventType": "RecordStateChanged", "eventData": { "outputActive": false, "outputState": "OBS_WEBSOCKET_OUTPUT_STARTING", "outputPath": null } },
        { "delayMs": 100, "eventType": "RecordStateChanged", "eventData": { "outputActive": true, "outputState": "OBS_WEBSOCKET_OUTPUT_STARTED", "outputPath": "[path]" } }
      ],
      "effect": { "recording": true }
    },
    {
      "requestType": "ToggleRecord",
      "when": { "recording": true },
      "status": { "result": true, "code": 100 },
      "responseData": { "outputActive": false },
      "events": [
        { "delayMs": 1, "eventType": "RecordStateChanged", "eventData": { "outputActive": false, "outputState": "OBS_WEBSOCKET_OUTPUT_STOPPING", "outputPath": null } },
        { "delayMs": 230, "eventType": "RecordStateChanged", "eventData": { "outputActive": false, "outputState": "OBS_WEBSOCKET_OUTPUT_STOPPED", "outputPath": "[path]" } }
      ],
      "effect": { "recording": false }
    },
    {
      "requestType": "PauseRecord",
      "when": { "recording": true, "paused": false },
      "status": { "result": true, "code": 100 },
      "events": [{ "delayMs": 21, "eventType": "RecordStateChanged", "eventData": { "outputActive": false, "outputState": "OBS_WEBSOCKET_OUTPUT_PAUSED", "outputPath": null } }],
      "effect": { "paused": true }
    },
    { "requestType": "PauseRecord", "when": { "recording": true, "paused": true }, "status": { "result": false, "code": 502 } },
    { "requestType": "PauseRecord", "when": { "recording": false }, "status": { "result": false, "code": 501 } },
    {
      "requestType": "ResumeRecord",
      "when": { "recording": true, "paused": true },
      "status": { "result": true, "code": 100 },
      "events": [{ "delayMs": 6, "eventType": "RecordStateChanged", "eventData": { "outputActive": true, "outputState": "OBS_WEBSOCKET_OUTPUT_RESUMED", "outputPath": null } }],
      "effect": { "paused": false }
    },
    { "requestType": "ResumeRecord", "when": { "recording": true, "paused": false }, "status": { "result": false, "code": 503 } },
    { "requestType": "ResumeRecord", "when": { "recording": false }, "status": { "result": false, "code": 501 } },
    { "requestType": "StopOutput", "requestData": { "outputName": "simple_file_output" }, "when": { "recording": true }, "status": { "result": true, "code": 100 }, "effect": { "recording": false } },
    { "requestType": "StartOutput", "requestData": { "outputName": "simple_file_output" }, "when": { "recording": true }, "status": { "result": false, "code": 500 } },
    { "requestType": "ToggleOutput", "requestData": { "outputName": "simple_file_output" }, "when": { "recording": true }, "status": { "result": true, "code": 100 }, "responseData": { "outputActive": false }, "effect": { "recording": false } },
    {
      "requestType": "TriggerHotkeyByName",
      "requestData": { "hotkeyName": "OBSBasic.StopRecording" },
      "when": { "recording": true },
      "status": { "result": true, "code": 100 },
      "events": [
        { "delayMs": 1, "eventType": "RecordStateChanged", "eventData": { "outputActive": false, "outputState": "OBS_WEBSOCKET_OUTPUT_STOPPING", "outputPath": null } },
        { "delayMs": 230, "eventType": "RecordStateChanged", "eventData": { "outputActive": false, "outputState": "OBS_WEBSOCKET_OUTPUT_STOPPED", "outputPath": "[path]" } }
      ],
      "effect": { "recording": false }
    }
  ]
}
